# Target player. These defaults are the existing ashfury Dota account.
TARGET_ACCOUNT_ID=212121467
TARGET_STEAM_ID64=76561198172387195

# Required. Never commit real values.
STEAM_WEB_API_KEY=
STEAM_GC_REFRESH_TOKEN=
STEAM_DATA_DIR=./state/steam
REQUEST_TIMEOUT_MS=15000

# Requested polling policy.
PRESENCE_POLL_MS=600000
RESULT_POLL_MS=10000

# Local durable state and one-copy-per-match Valve cache.
MONITOR_STATE_FILE=./state/monitor-state.json
VALVE_MATCH_CACHE_DIR=./cache/matches
